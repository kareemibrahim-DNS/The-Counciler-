# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
BRAIN_OWNER_SLACK_ID=U08DW8E5WKW

# Claude
ANTHROPIC_API_KEY=sk-ant-...
BRAIN_MODEL=claude-sonnet-5-5

# Salesforce (read-only). Use EITHER username/password/token OR instance URL + access token.
# Recommended: a dedicated read-only integration user.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login
# SF_INSTANCE_URL=https://foodics.my.salesforce.com
# SF_ACCESS_TOKEN=

# Google (Sheets + Drive, read-only). Share the sheets and the Drive folder with the service account's email.
# On Railway, paste the key's JSON (or its base64) as a secret. Never commit the key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Locally you can point to the key file instead (keep it outside the repo):
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/outside/the/repo/key.json
# Optional: act as a Workspace user (needs domain-wide delegation from IT)
# GOOGLE_IMPERSONATE=<mailbox>@foodics.com
# Drive folder ids drive_search may look in (comma-separated). Kept out of git; without it drive_search is off.
BRAIN_DRIVE_FOLDERS=

# Cost prices and contracts: Slack IDs with the cost grant (comma-separated; they also need manager in layers.yaml)
BRAIN_COST_SLACK_IDS=
# Team, manager, cost and owner knowledge: base64 (optionally gzipped) JSON list. Kareem keeps the value; never commit it.
BRAIN_OWNER_KNOWLEDGE_B64=
# Optional: answer length (default 4000) and a server-side copy of layers.yaml with the real sheets (never in this repo)
# BRAIN_MAX_TOKENS=4000
# BRAIN_LAYERS_FILE=/data/layers.yaml
# State and learned facts (on Railway, on the /data volume)
# BRAIN_STATE_FILE=/data/state.json
# BRAIN_LEARN_QUEUE=/data/learn_queue.json
# BRAIN_OWNER_LEARNED_FILE=/data/learned_owner.md
# BRAIN_TEAM_LEARNED_FILE=/data/learned_team.md
# BRAIN_COMPETITOR_QUOTES=/data/competitor_quotes.json
